# Use ncc-pc-1 on PC 1 and ncc-pc-2 on PC 2.
MONITOR_HOST_ID=ncc-pc-1
MONITOR_URL=http://192.168.1.10:8080
MONITOR_TOKEN=
MONITOR_INTERVAL_SECONDS=15
# Optional explicit LAN address if the host has several network adapters.
# MONITOR_IP=192.168.1.10
# Optional filesystem to measure. Defaults to the root of the current drive.
# MONITOR_DISK_PATH=C:/
