# Docker Compose settings. Use distinct random secrets.
BIND_ADDRESS=127.0.0.1
APP_PORT=8080
DB_USER=sentinelops
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=

# Both values are required to create the first account on an empty database.
BOOTSTRAP_EMAIL=admin@sentinelops.local
BOOTSTRAP_PASSWORD=

# Distinct random credentials for the two host agents (32+ characters each).
MONITOR_PC1_TOKEN=
MONITOR_PC2_TOKEN=
MONITOR_OFFLINE_SECONDS=90
